{
  "name": "weir-harness",
  "version": "0.7.0",
  "type": "module",
  "description": "Weir \u2014 orchestrator-centric DSH agent preset: intent gate, category delegation, todo driver, pull-based background jobs, auto-compaction, hashline edit.",
  "license": "MIT",
  "author": "Lim-Young",
  "homepage": "https://github.com/WeirLabs/weir#readme",
  "bugs": "https://github.com/WeirLabs/weir/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeirLabs/weir.git",
    "directory": "plugins/weir-harness"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "orchestrator",
    "weir"
  ],
  "files": [
    "src",
    "lib",
    "skills",
    "cordis.patch.yml",
    "whitelist-defaults.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./core": "./src/core/index.js",
    "./creative-guide": "./src/creative-guide/index.js",
    "./intent-gate": "./src/intent-gate/index.js",
    "./delegate": "./src/delegate/index.js",
    "./todo-driver": "./src/todo-driver/index.js",
    "./context-guard": "./src/context-guard/index.js",
    "./hashline-edit": "./src/hashline-edit/index.js",
    "./edit-lock": "./src/edit-lock/index.js",
    "./blackboard": "./src/blackboard/index.js",
    "./blackboard-remote": "./src/blackboard/remote.js",
    "./worktree": "./src/worktree/index.js",
    "./settings": "./src/settings/index.js",
    "./skill-selection": "./src/capabilities/skill-selection-plugin.js",
    "./capability-remote": "./src/capabilities/capability-remote.js",
    "./lsp": "./src/lsp/index.js",
    "./notify": "./src/notify/index.js",
    "./client": "./lib/client.js",
    "./index.js": "./lib/index.js",
    ".": "./lib/index.js",
    "./mcp-manager": "./src/capabilities/mcp-manager.js",
    "./mcp-facade-plugin": "./src/capabilities/mcp-facade-plugin.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "check": "tsc --noEmit -p jsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "prepack": "pnpm run check && pnpm test && pnpm run build"
  }
}
