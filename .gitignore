# AI tools & process material (never committed)
.claude/
.agent/
.agents/
openspec/

# docs/: local design & spike notes stay uncommitted;
# docs/features/ holds the versioned product feature docs (committed).
docs/*
!docs/features/

# Harness runtime scratch (notepads, research notes written by orrery sessions)
.orrery/
# Authentic replay evidence only; other runtime state remains ignored.
!plugins/orrery-test-harness/test/fixtures/traces/rehydrate/ws/.orrery/
plugins/orrery-test-harness/test/fixtures/traces/rehydrate/ws/.orrery/*
!plugins/orrery-test-harness/test/fixtures/traces/rehydrate/ws/.orrery/audit.jsonl
!plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/
plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/*
!plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/audit.jsonl
!plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/worktrees/
plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/worktrees/*
!plugins/orrery-test-harness/test/fixtures/traces/worktree/ws/.orrery/worktrees/lanes.json

# Handoff and install runbooks (local process material, distributed with the tree)
handoff-*.md
install-guide-*.md

# AI-generated working reports (kept locally only)
omo-feature-inventory.md
omo-architecture-map.md
dsh-plugin-authoring-surface.md

# Dependencies & build output
node_modules/
**/node_modules/
.pnpm-store/
plugins/*/lib/
plugins/*/dist/
# The bundle's client half is AUTHORED in the build-output format (no build
# step — zero-dependency discipline); un-ignore that one directory's files.
!plugins/orrery-harness/lib/
!plugins/orrery-model-picker/lib/

# Secrets & credentials (never committed)
.env
.env.*
*.pem
*.key
secrets/

# OS junk & editor config
.DS_Store
.vscode/
