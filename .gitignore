# AI tools & process material (never committed)
.claude/
.agent/
.agents/
openspec/

# docs/: local design & spike notes stay uncommitted;
# docs/features/ holds the versioned product feature docs (committed).
docs/*
!docs/features/
# docs/assets/ holds committed brand & README imagery (SVG).
!docs/assets/

# Harness runtime scratch (notepads, research notes written by weir sessions)
.weir/
# Authentic replay evidence only; other runtime state remains ignored.
# One wildcard ruleset covers EVERY scenario fixture workspace (no per-fixture
# stanzas): un-ignore ws/.weir/ itself, re-ignore its contents, then un-ignore
# the trackable state-file kinds level by level. The kind enum maps 1:1 to
# TRACKABLE_WEIR_STATE_KINDS in
# plugins/weir-test-harness/test/fixture-selfcontainment.test.js — extend
# both sides together; the conformance suite fails while they diverge.
!plugins/weir-test-harness/test/fixtures/**/ws/.weir/
plugins/weir-test-harness/test/fixtures/**/ws/.weir/*
!plugins/weir-test-harness/test/fixtures/**/ws/.weir/audit.jsonl
!plugins/weir-test-harness/test/fixtures/**/ws/.weir/worktrees/
plugins/weir-test-harness/test/fixtures/**/ws/.weir/worktrees/*
!plugins/weir-test-harness/test/fixtures/**/ws/.weir/worktrees/lanes.json

# Handoff and install runbooks (local process material, distributed with the tree)
handoff-*.md
install-guide-*.md

# AI-generated working reports (kept locally only)
omo-feature-inventory.md
omo-architecture-map.md
dsh-plugin-authoring-surface.md

# Dependencies & build output
node_modules/
**/node_modules/
.pnpm-store/
plugins/*/lib/
plugins/*/dist/
# The bundle's client half is AUTHORED in the build-output format (no build
# step — zero-dependency discipline); un-ignore that one directory's files.
!plugins/weir-harness/lib/

# Secrets & credentials (never committed)
.env
.env.*
*.pem
*.key
secrets/

# OS junk & editor config
.DS_Store
.vscode/
